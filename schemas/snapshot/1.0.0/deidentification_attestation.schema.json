{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coe:schema:deidentification-attestation:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_schema_version", "snapshot_id", "created_at", "data_classification", "method", "profile",
    "status", "documents_index_sha256", "approved_for_coe_processing", "approver_ref", "findings_count",
    "direct_identifiers_detected", "scanner_tools"
  ],
  "properties": {
    "attestation_schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "data_classification": {"const": "synthetic_phi_free"},
    "method": {"const": "synthetic_fixture"},
    "profile": {"$ref": "#/$defs/tool"},
    "status": {"const": "passed"},
    "documents_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_for_coe_processing": {"const": true},
    "approver_ref": {"const": "TEST-ONLY"},
    "findings_count": {"const": 0},
    "direct_identifiers_detected": {"const": false},
    "scanner_tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}}
  },
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    }
  }
}


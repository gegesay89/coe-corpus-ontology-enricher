{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coe:schema:artifact-manifest:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_manifest_schema_version", "run_fingerprint", "semantic_content_sha256", "files"],
  "properties": {
    "artifact_manifest_schema_version": {"const": "1.0.0"},
    "run_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_content_sha256": {"$ref": "#/$defs/sha256"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "media_type", "schema_version", "row_count", "byte_count", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "media_type": {"type": "string"},
        "schema_version": {"const": "1.0.0"}, "row_count": {"type": "integer", "minimum": 0},
        "byte_count": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {"minimum": 0, "type": "integer"},
        "media_type": {"const": "application/x-ndjson"},
        "path": {"enum": ["ambiguity_counts.jsonl", "coding_counts.jsonl"]},
        "row_count": {"minimum": 0, "type": "integer"},
        "schema_version": {"const": "1.0.0"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["byte_count", "media_type", "path", "row_count", "schema_version", "sha256"],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "release_id": {"maxLength": 2048, "minLength": 1, "type": "string"},
        "system_uri": {"format": "uri", "maxLength": 2048, "type": "string"}
      },
      "required": ["release_id", "system_uri"],
      "type": "object"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "max_candidates_per_phrase_system": {"minimum": 1, "type": "integer"},
        "max_file_bytes": {"minimum": 1, "type": "integer"},
        "max_files": {"minimum": 1, "type": "integer"},
        "max_ngram_tokens": {"minimum": 1, "type": "integer"},
        "max_ngrams_per_file": {"minimum": 1, "type": "integer"},
        "max_tokens_per_file": {"minimum": 1, "type": "integer"},
        "max_total_bytes": {"minimum": 1, "type": "integer"},
        "max_total_ngrams": {"minimum": 1, "type": "integer"},
        "max_total_tokens": {"minimum": 1, "type": "integer"},
        "max_unique_phrases": {"minimum": 1, "type": "integer"},
        "max_walk_entries": {"minimum": 1, "type": "integer"}
      },
      "required": [
        "max_candidates_per_phrase_system",
        "max_file_bytes",
        "max_files",
        "max_ngram_tokens",
        "max_ngrams_per_file",
        "max_tokens_per_file",
        "max_total_bytes",
        "max_total_ngrams",
        "max_total_tokens",
        "max_unique_phrases",
        "max_walk_entries"
      ],
      "type": "object"
    }
  },
  "$id": "https://coe.example.invalid/schemas/protected/1.0.0/run_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "additionalProperties": false,
      "properties": {
        "approval_ref_count": {"minimum": 2, "type": "integer"},
        "approved": {"const": true},
        "attestation_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "output_classification": {"const": "protected_aggregate"},
        "profile": {"const": "protected_phi_local"},
        "retention_policy_id": {"maxLength": 256, "minLength": 1, "type": "string"}
      },
      "required": ["approval_ref_count", "approved", "attestation_sha256", "output_classification", "profile", "retention_policy_id"],
      "type": "object"
    },
    "artifacts": {"items": {"$ref": "#/$defs/artifact"}, "maxItems": 2, "minItems": 2, "type": "array"},
    "execution_profile": {"const": "protected_phi_local"},
    "grounding": {
      "additionalProperties": false,
      "properties": {
        "candidate_count_checked": {"minimum": 0, "type": "integer"},
        "status": {"const": "passed"}
      },
      "required": ["candidate_count_checked", "status"],
      "type": "object"
    },
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 4, "type": "array"},
    "matching": {
      "additionalProperties": false,
      "properties": {
        "device": {"const": "cpu"},
        "method": {"const": "exact_preferred_and_alias"},
        "nvidia_preflight": {"enum": ["not_required", "passed"]}
      },
      "required": ["device", "method", "nvidia_preflight"],
      "type": "object"
    },
    "processing_totals": {
      "additionalProperties": false,
      "properties": {
        "corpus_content_set_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "file_count": {"minimum": 1, "type": "integer"},
        "total_bytes": {"minimum": 0, "type": "integer"},
        "total_characters": {"minimum": 0, "type": "integer"},
        "total_ngrams": {"minimum": 0, "type": "integer"},
        "total_tokens": {"minimum": 0, "type": "integer"},
        "unique_form_count": {"minimum": 0, "type": "integer"}
      },
      "required": [
        "corpus_content_set_sha256",
        "file_count",
        "total_bytes",
        "total_characters",
        "total_ngrams",
        "total_tokens",
        "unique_form_count"
      ],
      "type": "object"
    },
    "resource_limits": {"$ref": "#/$defs/limits"},
    "run_fingerprint": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "run_report_schema_version": {"const": "protected-local-1.0.0"},
    "semantic_output_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "status": {"const": "succeeded"},
    "terminologies": {"items": {"$ref": "#/$defs/identity"}, "minItems": 1, "type": "array"},
    "totals": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_row_count": {"minimum": 0, "type": "integer"},
        "coding_count_row_count": {"minimum": 0, "type": "integer"}
      },
      "required": ["ambiguity_row_count", "coding_count_row_count"],
      "type": "object"
    }
  },
  "required": [
    "attestation",
    "artifacts",
    "execution_profile",
    "grounding",
    "limitations",
    "matching",
    "processing_totals",
    "resource_limits",
    "run_fingerprint",
    "run_report_schema_version",
    "semantic_output_sha256",
    "status",
    "terminologies",
    "totals"
  ],
  "title": "COE protected-local run report",
  "type": "object"
}

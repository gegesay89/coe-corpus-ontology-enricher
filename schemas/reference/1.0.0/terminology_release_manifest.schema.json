{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coe:schema:terminology-release-manifest:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version", "coding_schema_version", "designation_schema_version", "release_id", "system_uri",
    "system_name", "publisher", "version", "effective_date", "language", "source_uri", "content_set_sha256",
    "files", "code_format", "active_policy", "relationship_policy", "entitlement", "notices"
  ],
  "properties": {
    "manifest_schema_version": {"const": "1.0.0"},
    "coding_schema_version": {"const": "1.0.0"},
    "designation_schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "format": "uuid"},
    "system_uri": {"type": "string", "pattern": "^urn:coe:synthetic:"},
    "system_name": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "effective_date": {"type": "string", "format": "date"},
    "language": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "format": "uri"},
    "content_set_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "object", "additionalProperties": false, "required": ["codings", "designations"],
      "properties": {"codings": {"$ref": "#/$defs/payload"}, "designations": {"$ref": "#/$defs/payload"}}
    },
    "code_format": {
      "type": "object", "additionalProperties": false, "required": ["pattern", "max_length"],
      "properties": {"pattern": {"type": "string", "maxLength": 128}, "max_length": {"type": "integer", "minimum": 1, "maximum": 64}}
    },
    "active_policy": {"const": "include_active_and_inactive"},
    "relationship_policy": {"const": "none"},
    "entitlement": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_ref", "approval_ref", "analysis_use_permitted", "permitted_environments", "review_date", "allowed_derived_uses", "allowed_export_profiles"],
      "properties": {
        "owner_ref": {"const": "TEST-ONLY"}, "approval_ref": {"const": "TEST-ONLY"},
        "analysis_use_permitted": {"const": true}, "permitted_environments": {"const": ["synthetic"]},
        "review_date": {"type": "string", "format": "date"}, "allowed_derived_uses": {"const": ["test"]},
        "allowed_export_profiles": {"const": ["synthetic-internal"]}
      }
    },
    "notices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_count", "row_count", "schema_version"],
      "properties": {
        "path": {"enum": ["codings.jsonl", "designations.jsonl"]}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0}, "row_count": {"type": "integer", "minimum": 0},
        "schema_version": {"const": "1.0.0"}
      }
    }
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coe:schema:coding-row:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["code", "active", "definition", "semantic_types", "properties"],
  "properties": {
    "code": {"type": "string", "minLength": 1, "maxLength": 64}, "active": {"type": "boolean"},
    "definition": {"type": ["string", "null"]},
    "semantic_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {"type": "object", "additionalProperties": {"type": ["string", "integer", "boolean", "null"]}}
  }
}

